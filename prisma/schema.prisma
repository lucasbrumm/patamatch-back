// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @default(autoincrement()) @id
  email String  @unique
  name  String?
  phone String?
  dogs  Dog[]
  favoriteDogs DogFavorite[]
  adoptions DogAdoption[]
  image UserImage?

  @@map("users")
}


model Dog {
  id          Int      @default(autoincrement()) @id
  name        String
  breed       String
  age         Int
  size        String   // "small", "medium", "large"
  gender      String   // "male", "female"
  description String?
  isAdopted   Boolean  @default(false) @map("is_adopted")
  isAvailable Boolean  @default(true) @map("is_available")
  isVaccinated Boolean @default(false) @map("is_vaccinated")
  isCastrated  Boolean @default(false) @map("is_castrated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User?    @relation(fields: [ownerId], references: [id])
  ownerId     Int?     @map("owner_id")
  images      DogImage[]
  localization DogLocalization?
  favoritedBy DogFavorite[]
  adoptions   DogAdoption[]

  @@map("dogs")
}

model DogLocalization {
  latitude  Float
  longitude Float
  dog       Dog     @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId     Int     @id @map("dog_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dog_localizations")
}

model DogImage {
  id        Int      @default(autoincrement()) @id
  imageData String   @map("image_data") // Base64 encoded image
  mimeType  String   @map("mime_type") // e.g., "image/jpeg", "image/png"
  filename  String?  // Original filename
  size      Int?     // File size in bytes
  order     Int      @default(1) // Order of image (1-8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId     Int      @map("dog_id")

  @@map("dog_images")
}

model DogFavorite {
  id         Int      @default(autoincrement()) @id
  isFavorite Boolean  @default(true) @map("is_favorite")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int      @map("user_id")
  dog        Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId      Int      @map("dog_id")

  @@unique([userId, dogId])
  @@map("dog_favorites")
}

model UserImage {
  id        Int      @default(autoincrement()) @id
  imageData String   @map("image_data") // Base64 encoded image
  mimeType  String   @map("mime_type") // e.g., "image/jpeg", "image/png"
  filename  String?  // Original filename
  size      Int?     // File size in bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique @map("user_id") // One-to-one relationship

  @@map("user_images")
}

model DogAdoption {
  id        Int      @default(autoincrement()) @id
  status    String   // "pending", "approved", "rejected", "completed", "cancelled"
  notes     String?  // Optional notes about the adoption
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId     Int      @map("dog_id")

  @@unique([userId, dogId])
  @@map("dog_adoptions")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @default(autoincrement()) @id
  email String  @unique
  name  String?
  posts Post[]
  dogs  Dog[]
  favoriteDogs DogFavorite[]

  @@map("users")
}

model Post {
  id          Int      @default(autoincrement()) @id
  title       String
  content     String?
  published   Boolean  @default(false)
  postType    String   @default("general") @map("post_type") // "adoption", "general", "update"
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  author      User?    @relation(fields: [authorId], references: [id])
  authorId    Int?     @map("author_id")
  dog         Dog?     @relation(fields: [dogId], references: [id])
  dogId       Int?     @map("dog_id")
  localization PostLocalization?

  @@map("posts")
}

model Dog {
  id          Int      @default(autoincrement()) @id
  name        String
  breed       String
  age         Int
  size        String   // "small", "medium", "large"
  gender      String   // "male", "female"
  description String?
  isAdopted   Boolean  @default(false) @map("is_adopted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User?    @relation(fields: [ownerId], references: [id])
  ownerId     Int?     @map("owner_id")
  posts       Post[]
  images      DogImage[]
  favoritedBy DogFavorite[]

  @@map("dogs")
}

model PostLocalization {
  latitude  Float
  longitude Float
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int     @id @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("post_localizations")
}

model DogImage {
  id        Int      @default(autoincrement()) @id
  imageData String   @map("image_data") // Base64 encoded image
  mimeType  String   @map("mime_type") // e.g., "image/jpeg", "image/png"
  filename  String?  // Original filename
  size      Int?     // File size in bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId     Int      @map("dog_id")

  @@map("dog_images")
}

model DogFavorite {
  id        Int      @default(autoincrement()) @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  dog       Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId     Int      @map("dog_id")

  @@unique([userId, dogId])
  @@map("dog_favorites")
}
